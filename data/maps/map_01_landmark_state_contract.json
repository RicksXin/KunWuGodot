{
  "schemaVersion": 1,
  "status": "d1_state_contract",
  "mapId": "map_01",
  "layoutIntegration": {
    "formalCoordinatesFrozen": false,
    "runtimeSceneMutationAllowed": false,
    "reason": "The 48x64 object coordinates and two shared-cell conflicts still require a formal product freeze."
  },
  "persistenceContract": {
    "owner": "external Map01 runtime/save adapter",
    "presentationController": "res://scripts/maps/map01_landmark_progress.gd",
    "rule": "The presentation controller consumes external state and never writes user profile data."
  },
  "lamps": [
    {
      "objectId": "m1_event_lamp_01",
      "stateKey": "map_01.landmarks.m1_event_lamp_01.state",
      "initialState": "LAMP_REVERSED",
      "allowedStates": ["LAMP_BROKEN", "LAMP_REVERSED", "LAMP_REPAIRED"]
    },
    {
      "objectId": "m1_event_lamp_02",
      "stateKey": "map_01.landmarks.m1_event_lamp_02.state",
      "initialState": "LAMP_BROKEN",
      "allowedStates": ["LAMP_BROKEN", "LAMP_REVERSED", "LAMP_REPAIRED"]
    },
    {
      "objectId": "m1_event_lamp_03",
      "stateKey": "map_01.landmarks.m1_event_lamp_03.state",
      "initialState": "LAMP_BROKEN",
      "allowedStates": ["LAMP_BROKEN", "LAMP_REVERSED", "LAMP_REPAIRED"]
    }
  ],
  "boss": {
    "objectId": "m1_boss_gate_spirit",
    "defeatedKey": "map_01.encounters.m1_boss_gate_spirit.defeated"
  },
  "gate": {
    "visualId": "m1_landmark_wanxiu_gate",
    "stateIsDerived": true,
    "rules": [
      {
        "state": "GATE_LOCKED",
        "when": "any lamp is not LAMP_REPAIRED"
      },
      {
        "state": "GATE_BOSS_READY",
        "when": "all three lamps are LAMP_REPAIRED and Boss is not defeated"
      },
      {
        "state": "GATE_OPEN",
        "when": "all three lamps are LAMP_REPAIRED and Boss is defeated"
      }
    ]
  },
  "derelictCamp": {
    "visualId": "m1_landmark_derelict_camp",
    "baseState": "CAMP_STAY_BASE",
    "baseIsStatic": true,
    "corpseEvidence": {
      "objectId": "m1_event_corpses",
      "stateKey": "map_01.landmarks.m1_event_corpses.state",
      "initialState": "CAMP_CORPSES_DEFAULT",
      "allowedStates": ["CAMP_CORPSES_DEFAULT", "CAMP_CORPSES_PROCESSED"]
    },
    "ledgerBoundary": {
      "objectId": "m1_event_ledger",
      "independent": true,
      "rule": "The ledger remains a distant independent map object and never selects a derelict-camp sprite state."
    }
  }
}
