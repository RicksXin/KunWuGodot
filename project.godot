; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="昆吾禁地"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.027, 0.039, 0.055, 1)
boot_splash/show_image=false

[autoload]

ConfigRepository="*res://scripts/autoload/config_repository.gd"
Game="*res://scripts/autoload/game.gd"

[kunwu]

config_base_url=""
config_channel="development"
config_request_timeout_seconds=3.0

[display]

window/size/viewport_width=375
window/size/viewport_height=817
window/size/window_width_override=750
window/size/window_height_override=1634
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/TileMapDual/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

