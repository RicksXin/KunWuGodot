[sub_resource type="Shader" id="Shader_5510t"]
code = "shader_type canvas_item;
uniform bool animated = true;
varying vec2 local_point;
void vertex() { local_point = VERTEX; }
void fragment() { vec4 base = texture(TEXTURE, UV); float t = animated ? TIME : 0.0; float ripple = sin(local_point.y * 0.35 + sin(local_point.x * 0.08 + t) * 1.5 - t * 2.0); base.rgb += vec3(0.035, 0.065, 0.065) * smoothstep(0.8, 1.0, ripple); COLOR = base; }"

